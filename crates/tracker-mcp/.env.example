# Tracker API auth (required)
TRACKER_TOKEN=<твой-oauth-или-iam-токен>
TRACKER_ORG_ID=<id-организации>

# Tracker API (optional, defaults to prod)
TRACKER_TOKEN_KIND=oauth
TRACKER_ORG_KIND=x_org_id
TRACKER_BASE_URL=https://api.tracker.yandex.net/v3

# MCP HTTP server auth (required for security)
MCP_AUTH_TOKEN=<сгенерировать-openssl-rand-hex-32>

# MCP HTTP server (optional)
PORT=8080
MCP_ALLOW_NO_AUTH=0
MCP_ALLOWED_HOSTS=

# Yandex Serverless optimization (set to 1 for serverless)
MCP_STATELESS=1
